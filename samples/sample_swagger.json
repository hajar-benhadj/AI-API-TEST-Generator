{
  "openapi": "3.0.0",
  "info": {
    "title": "Sample E-commerce API",
    "version": "1.0.0"
  },
  "paths": {
    "/users": {
      "get": {
        "summary": "Get all users",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      },
      "post": {
        "summary": "Create a new user",
        "responses": {
          "201": {
            "description": "User created"
          }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "Get list of products",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    }
  }
}